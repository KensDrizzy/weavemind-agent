llm:
  provider: anthropic        # anthropic | deepseek | mimo | openai
  model: claude-sonnet-4-20250514
  max_tokens: 8192
  temperature: 0

providers:
  anthropic:
    api_key_env: ANTHROPIC_API_KEY

  deepseek:
    base_url: https://api.deepseek.com/anthropic
    api_key_env: DEEPSEEK_API_KEY
    default_model: deepseek-v4-pro

  mimo:
    base_url: https://token-plan-cn.xiaomimimo.com/anthropic
    api_key_env: MIMO_API_KEY
    default_model: mimo-v2.5-pro

memory:
  project_file: .weavemind/MEMORY.md
  claude_md: CLAUDE.md
  long_term_file: .weavemind/memory/long_term.json
  core_file: .weavemind/memory/core.json
  compaction:
    retain_recent_rounds: 3
    chunk_size: 5

session:
  storage_dir: .weavemind/sessions
  compaction_threshold: 80000

permissions:
  default_mode: default

team:
  auto_detect: true
  classifier_provider: deepseek
  classifier_model: deepseek-v4-pro

tools:
  allowed: []
  disallowed: []

rag:
  enabled: false
  force_search_code: true
  chroma_dir: .weavemind/chroma
  keyword_db: .weavemind/rag/keyword_index.db
  chunk_size: 500
  chunk_overlap: 100
  embedding:
    provider: openai
    model: text-embedding-v3
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key_env: DASHSCOPE_API_KEY
  retrieval:
    strategy: hybrid
    top_k: 10
    max_per_file: 2
    fusion: weighted          # weighted（默认，加权求和）| rrf（Reciprocal Rank Fusion，无须分数归一化）
    rrf_k: 60                 # 仅 fusion=rrf 时生效；OpenSearch/LangChain 默认值
  query_rewrite:
    enabled: true
    method: rules          # rules | llm | auto
    max_queries: 3
    symbol_limit: 40       # LLM/auto 改写时提供的项目符号候选数量
    # provider/model 可选；不填则复用 llm.provider / llm.model
    provider:
    model:
  rerank:
    enabled: true
    method: heuristic      # heuristic | cross_encoder | llm
    top_n: 20              # 先召回 top_n 候选，再重排取 top_k
    model: cross-encoder/ms-marco-MiniLM-L-6-v2  # cross_encoder 使用，需安装 sentence-transformers
    # llm_model 可选；method=llm 时不填则复用 llm.model
    provider:
    llm_model:
  cache:
    enabled: true
    ttl_seconds: 300
    max_entries: 128

# 微信 iLink 通道（独立运行：weavemind wechat setup/start）
wechat:
  api_base_url: https://ilinkai.weixin.qq.com
  app_id: bot
  route_tag:
  account_file: ~/.weavemind/wechat/account.json
  login_timeout_seconds: 480
  poll_timeout_seconds: 35
  busy_poll_timeout_seconds: 3
  typing_refresh_seconds: 5
  queue_max_size: 20
  max_reply_chars: 3800
  max_conversation_messages: 40
  private_chat_only: true
  security:
    # 远程入口固定为失败关闭；这里只能从内置只读集合中做减法。
    allowed_tools:
      - Read
      - Glob
      - Grep
      - SearchCode
      - WebSearch
      - WebFetch
      - MemorySearch
      - load_skill
